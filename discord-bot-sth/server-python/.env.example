# =============================================================================
# Subway-Thots-Hotel — Discord auth & community system  (PLACEHOLDERS ONLY)
# Copy this file to .env and fill in real values. NEVER commit the real .env.
# =============================================================================

# ---- Discord application / OAuth2 ----
DISCORD_APPLICATION_ID=1534024034411614258
DISCORD_CLIENT_ID=1534024034411614258
DISCORD_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
DISCORD_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
DISCORD_REDIRECT_URI=http://147.189.172.104/7076/auth/discord/callback
DISCORD_GUILD_ID=1534020917825503282
DISCORD_INVITE_URL=https://discord.gg/6BHMKxzCbF

# ---- Discord role IDs ----
DISCORD_OWNER_ROLE_ID=1534021734984843364
DISCORD_ADMIN_ROLE_ID=1534021562561466440
DISCORD_STAFF_ROLE_ID=1534021351256494080
DISCORD_MODERATOR_ROLE_ID=1534021495511056485
DISCORD_PLAYER_ROLE_ID=1534021254691033128
DISCORD_VERIFIED_ROLE_ID=1534021354767253654
DISCORD_BANNED_ROLE_ID=1534022085146443918

# ---- Discord channel IDs ----
DISCORD_AUDIT_CHANNEL_ID=1534022456275112046
DISCORD_REGISTRATION_CHANNEL_ID=1534022419105452285
DISCORD_MODERATION_CHANNEL_ID=1534020918916026481
DISCORD_ANNOUNCEMENT_CHANNEL_ID=1534022330584662207

# ---- Owner ----
GAME_OWNER_DISCORD_USER_ID=1513224601751130132

# ---- Secrets (generate with: python -c "import secrets;print(secrets.token_hex(32))") ----
SESSION_SECRET=REPLACE_WITH_32_BYTE_RANDOM_HEX
AUTH_SECRET=REPLACE_WITH_32_BYTE_RANDOM_HEX

# ---- Database (PostgreSQL in production; SQLite fallback for local dev) ----
# Example: postgresql+psycopg://sth:PASSWORD@localhost:5432/sth
DATABASE_URL=sqlite:///./subway_thots_hotel.db

# ---- URLs ----
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:7076
WORLD_BIND_HOST=0.0.0.0
WORLD_BIND_PORT=7076

# ---- Security tuning ----
SESSION_TTL_SECONDS=86400
WS_TICKET_TTL_SECONDS=120
OAUTH_STATE_TTL_SECONDS=600
MEMBERSHIP_CACHE_TTL_SECONDS=600
CSRF_TOKEN_TTL_SECONDS=1800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RATE_LIMIT_PER_MINUTE=60

# ---- Name policy ----
RESERVED_NAMES=admin,administrator,owner,mod,moderator,staff,dev,developer,official,sth,subwaythotshotel,subway,thots,bot,system,support,help
BLOCKED_WORDS=REPLACE_WITH_COMMA_SEPARATED_BLOCKED_WORDS

# ---- VPS multiplayer world host (bot watches this /health endpoint) ----
WORLD_HOST_URL=http://147.189.172.104:7076

# ---- Optional: require WS ticket from the auth system on the world host ----
# Set to true only after the auth backend is live and the bot is running.
STH_REQUIRE_AUTH_TICKET=false
