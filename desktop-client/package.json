{
  "name": "subway-thots-hotel-desktop-client",
  "productName": "Subway Thots Hotel",
  "version": "0.1.0",
  "description": "Subway Thots Hotel Windows desktop client",
  "author": "LilToreyFTW",
  "main": "electron/main.js",
  "scripts": {
    "prepare-game": "node scripts/prepare-game-build.js",
    "verify-game": "node scripts/verify-game-build.js",
    "build": "npm run prepare-game && npm run verify-game",
    "dev": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable --publish never",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.liltoreyftw.subwaythotshotel",
    "productName": "Subway Thots Hotel",
    "executableName": "SubwayThotsHotel",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["electron/**/*", "launcher/**/*", "game-runtime/**/*", "package.json"],
    "icon": "build/icon.ico",
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }], "artifactName": "Subway-Thots-Hotel-${version}-${arch}.${ext}" },
    "portable": { "artifactName": "Subway-Thots-Hotel-${version}-${arch}-portable.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Subway Thots Hotel", "runAfterFinish": true, "artifactName": "Subway-Thots-Hotel-Setup-${version}-x64.exe" },
    "publish": { "provider": "github", "owner": "LilToreyFTW", "repo": "Subway-thots-hotel", "releaseType": "release" }
  }
}
