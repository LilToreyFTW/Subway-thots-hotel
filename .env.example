# SubwayThotsHotel Frontend environment configuration
# Copy this to .env if needed, Vercel reads VITE_-prefixed vars at build time

# Trusted secure WebSocket endpoint for the world host
# This MUST be wss:// when the game page is served over HTTPS
# Set this to your actual domain that points to 147.189.172.104
VITE_STH_WORLD_URL=wss://cyan-squirrel-97200.zap.cloud

# Optional: proximity voice (WebRTC signaling) endpoint
# VITE_STH_VOICE_URL=https://voice.subwaythotshotel.com

# Optional: STUN/TURN for voice NAT traversal
# VITE_STUN_URL=stun:stun.l.google.com:19302
# VITE_TURN_URL=turns:turn.subwaythotshotel.com:5349

# Optional: enable Discord-gated auth before the world starts (off = open play)
# VITE_STH_AUTH=on
# VITE_AUTH_API=https://auth.subwaythotshotel.com

# Authoritative host anti-cheat. Keep the debug secret server-side only.
# ANTI_CHEAT_DEBUG_SECRET=replace-with-a-random-32-byte-secret
# ANTI_CHEAT_MAX_STRIKES=3
# ANTI_CHEAT_INPUTS_PER_SECOND=40
