{
    # Port 80 belongs to another VPS application. Caddy validates TLS through
    # port 443 and does not install an HTTP redirect listener.
    auto_https disable_redirects
    admin off
}

cyan-squirrel-97200.zap.cloud {
    encode zstd gzip
    reverse_proxy 127.0.0.1:7076

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    log {
        output file logs/caddy-access.log {
            roll_size 10MiB
            roll_keep 5
            roll_keep_for 168h
        }
    }
}
