[Unit]
Description=Subway-Thots-Hotel Socket.io Voice Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/subway-thots-hotel/multiplayer-server
EnvironmentFile=/opt/subway-thots-hotel/multiplayer-server/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
User=sth
Group=sth
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/subway-thots-hotel/multiplayer-server

[Install]
WantedBy=multi-user.target
